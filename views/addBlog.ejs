<html lang="en">
  <head>
    <title><%= formTitle %></title>
    <%- include('./partials/style.ejs') -%>
  </head>

  <body>
    <%- include('./partials/topBar.ejs') -%>
    <main class="blog-editor-page">
      <a class="editor-back-link" href="/api/myBlogs"
        >&larr; Back to my blogs</a
      >
      <section class="blog-editor">
        <header class="editor-header">
          <p class="blogs-eyebrow">Make it yours</p>
          <h1 class="blogs-title"><%= formTitle %></h1>
          <p class="blogs-subtitle"><%= formSubtitle %></p>
        </header>

        <% if (message) { %>
        <p class="editor-message" role="alert"><%= message %></p>
        <% } %>

        <form
          class="blog-editor-form"
          action="<%= formAction %>"
          method="POST"
          enctype="multipart/form-data"
        >
          <label for="title">Title</label>
          <input
            type="text"
            id="title"
            name="title"
            value="<%= formData.title %>"
            placeholder="Give your story a title"
            maxlength="160"
            required
          />

          <label for="body">Your story</label>
          <textarea
            id="body"
            name="body"
            rows="12"
            placeholder="Start with the idea you can't stop thinking about..."
            required
          >
<%= formData.body %></textarea>

          <label for="image">Cover image <span>(optional)</span></label>
          <input
            type="file"
            id="image"
            name="image"
            accept="image/jpeg,image/png,image/webp"
          />
          <span class="editor-hint"
            >JPEG, PNG, or WebP. Maximum size: 5 MB.</span
          >

          <% if (imagePath) { %>
          <div class="editor-image-preview">
            <p>Current cover image</p>
            <img src="<%= imagePath %>" alt="Current cover image" />
            <span class="editor-hint"
              >Choose another image above to replace it.</span
            >
          </div>
          <% } %>

          <div class="editor-actions">
            <span class="editor-hint"
              >Your blog will be visible in your personal list.</span
            >
            <button type="submit"><%= submitLabel %></button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
