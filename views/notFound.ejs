<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found</title>
    <%- include('./partials/style.ejs') -%>
  </head>

  <body>
    <%- include('./partials/topBar.ejs') -%>
    <main class="not-found-page">
      <p class="not-found-code">ERROR 404</p>
      <h1 class="not-found-title">We couldn't find that page.</h1>
      <p class="not-found-copy">
        The address may be incorrect, or the page may have moved. Choose a
        destination below to continue.
      </p>
      <nav class="not-found-actions" aria-label="Suggested pages">
        <% if (isAuthenticated) { %>
        <a class="not-found-link not-found-link-primary" href="/api/home"
          >Go to home</a
        >
        <a class="not-found-link" href="/api/myBlogs">My blogs</a>
        <% } else { %>
        <a class="not-found-link not-found-link-primary" href="/api/login"
          >Go to login</a
        >
        <a class="not-found-link" href="/api/signup">Create an account</a>
        <% } %>
      </nav>
    </main>
  </body>
</html>
